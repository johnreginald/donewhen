# Raenil configuration (copy to .env for docker compose, or export for local dev)

# Public URL the app is served at (used for cookies, Web Push origin, deep links)
RAENIL_BASE_URL=http://localhost:8080

# HTTP listen address for the Go server
RAENIL_LISTEN_ADDR=:8080

# Postgres connection string
RAENIL_DATABASE_URL=postgres://raenil:raenil@localhost:5432/raenil?sslmode=disable

# dev | prod  (only "dev" may use the built-in dev secret; ANY other value, e.g. a
# typo, counts as prod: Secure cookies and RAENIL_SESSION_SECRET required)
RAENIL_ENV=dev

# Random 32+ byte secret for signing/session integrity (generate: openssl rand -hex 32)
RAENIL_SESSION_SECRET=change-me-please-32-bytes-minimum-secret

# Set only to confirm a backup before a destructive migration (see docs/DEPLOY.md):
# RAENIL_BACKUP_CONFIRMED=0036_plain_tracker.sql

# Issue key prefix (K => K-1, K-2, ...)
RAENIL_ISSUE_PREFIX=R

# Web Push VAPID keys (generate: ./raenil genvapid)
RAENIL_VAPID_PUBLIC=
RAENIL_VAPID_PRIVATE=
RAENIL_VAPID_SUBJECT=mailto:you@example.com

# ---- docker compose only ----
POSTGRES_USER=raenil
POSTGRES_PASSWORD=raenil
POSTGRES_DB=raenil
# Domain for Caddy auto-TLS (leave as :80 for local; set to your domain in prod)
RAENIL_SITE_ADDRESS=:80
