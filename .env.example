# Kanri configuration (copy to .env for docker-compose, or export for local dev)

# Public URL the app is served at (used for cookies, Web Push origin, deep links)
KANRI_BASE_URL=http://localhost:8080

# HTTP listen address for the Go server
KANRI_LISTEN_ADDR=:8080

# Postgres connection string
KANRI_DATABASE_URL=postgres://kanri:kanri@localhost:5432/kanri?sslmode=disable

# dev | prod  (prod => Secure cookies, requires HTTPS)
KANRI_ENV=dev

# Random 32+ byte secret for signing/session integrity (generate: openssl rand -hex 32)
KANRI_SESSION_SECRET=change-me-please-32-bytes-minimum-secret

# Issue key prefix (K => K-1, K-2, ...)
KANRI_ISSUE_PREFIX=K

# Web Push VAPID keys (generate: ./kanri genvapid)
KANRI_VAPID_PUBLIC=
KANRI_VAPID_PRIVATE=
KANRI_VAPID_SUBJECT=mailto:you@example.com

# ---- docker-compose only ----
POSTGRES_USER=kanri
POSTGRES_PASSWORD=kanri
POSTGRES_DB=kanri
# Domain for Caddy auto-TLS (leave as :80 for local; set to your domain in prod)
KANRI_SITE_ADDRESS=:80
