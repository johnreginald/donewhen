# DoneWhen configuration (copy to .env for docker compose, or export for local dev)

# Public URL the app is served at (used for cookies, Web Push origin, deep links)
DONEWHEN_BASE_URL=http://localhost:8080

# HTTP listen address for the Go server
DONEWHEN_LISTEN_ADDR=:8080

# Postgres connection string
DONEWHEN_DATABASE_URL=postgres://donewhen:donewhen@localhost:5432/donewhen?sslmode=disable

# dev | prod  (only "dev" may use the built-in dev secret; ANY other value, e.g. a
# typo, counts as prod: Secure cookies and DONEWHEN_SESSION_SECRET required)
DONEWHEN_ENV=dev

# Random 32+ byte secret for signing/session integrity (generate: openssl rand -hex 32)
DONEWHEN_SESSION_SECRET=change-me-please-32-bytes-minimum-secret

# Set only to confirm a backup before a destructive migration (see docs/SELF-HOSTING.md):
# DONEWHEN_BACKUP_CONFIRMED=0036_plain_tracker.sql

# Issue key prefix (K => K-1, K-2, ...)
DONEWHEN_ISSUE_PREFIX=R

# Header your reverse proxy sets to the real client IP, used for login rate
# limiting. Leave empty unless a proxy you control sits in front of DoneWhen (an
# untrusted header lets anyone dodge the limit). Cloudflare Tunnel:
# CF-Connecting-IP. Caddy or another proxy that appends to it: X-Forwarded-For.
DONEWHEN_TRUSTED_PROXY_HEADER=

# Web Push VAPID keys (generate: ./donewhen genvapid)
DONEWHEN_VAPID_PUBLIC=
DONEWHEN_VAPID_PRIVATE=
DONEWHEN_VAPID_SUBJECT=mailto:you@example.com

# ---- docker compose only ----
POSTGRES_USER=donewhen
POSTGRES_PASSWORD=donewhen
POSTGRES_DB=donewhen
# Domain for Caddy auto-TLS (leave as :80 for local; set to your domain in prod)
DONEWHEN_SITE_ADDRESS=:80
