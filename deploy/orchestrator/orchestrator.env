# Copy to ~/.config/raenil/orchestrator.env and fill in. chmod 600 — it holds a token.
RAENIL_URL=https://tracker.example.com
RAENIL_TOKEN=CHANGEME
# RAENIL_WORKSPACE=my-workspace
OPENCODE_URL=http://127.0.0.1:4096
# Worker: cheap and fast. Measured 3/4 on the bench suite with no cheating.
ORCHESTRATOR_MODEL=opencode-go/glm-5.3-flash
# Judge: also Flash — 3/3 correct at 5-19s, versus 67-77s on non-Flash.
ORCHESTRATOR_JUDGE_MODEL=opencode-go/glm-5.3-flash
# Escalation must be STRONGER than the worker. Setting this to the worker's own
# model makes escalation a no-op: triage already retries with the failure in
# context, so a same-model "escalation" just spends the attempt twice.
ORCHESTRATOR_ESCALATE_MODEL=opencode-go/glm-5.3
