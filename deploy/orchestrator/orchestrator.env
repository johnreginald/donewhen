# Copy to ~/.config/raenil/orchestrator.env and fill in. chmod 600 — it holds a token.
RAENIL_URL=https://tracker.example.com
RAENIL_TOKEN=CHANGEME
# RAENIL_WORKSPACE=my-workspace
OPENCODE_URL=http://127.0.0.1:4096
ORCHESTRATOR_MODEL=opencode-go/glm-5.3-flash
ORCHESTRATOR_ESCALATE_MODEL=opencode-go/glm-5.3
