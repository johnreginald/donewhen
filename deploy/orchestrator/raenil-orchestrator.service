# systemd user unit for the orchestrator daemon on a Linux box.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/orchestrator/raenil-orchestrator.service ~/.config/systemd/user/
#   cp deploy/orchestrator/orchestrator.env ~/.config/raenil/orchestrator.env   # then edit it
#   systemctl --user daemon-reload
#   systemctl --user enable --now raenil-orchestrator
#   loginctl enable-linger "$USER"     # so it runs without an active login
#
# Stop it working without stopping the service:
#   touch /path/to/repo/.orchestrator/STOP

[Unit]
Description=Raenil orchestrator daemon
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/raenil/orchestrator.env
ExecStart=/usr/local/bin/orchestrator daemon \
  --repo %h/Project/my-project \
  --run-root %h/Project/my-project/.orchestrator \
  --max-cost-hour 5.00 \
  --max-cost 2.00
Restart=on-failure
RestartSec=30

# The daemon only ever needs the repositories it works and its own run root.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
