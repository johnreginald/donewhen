<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd unit for the orchestrator daemon on a macOS dev machine.

  Install:
    cp deploy/orchestrator/dev.raenil.orchestrator.plist ~/Library/LaunchAgents/
    # edit the paths and the env block below first
    launchctl load -w ~/Library/LaunchAgents/dev.raenil.orchestrator.plist

  Stop it working without unloading anything:
    touch /path/to/repo/.orchestrator/STOP
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.raenil.orchestrator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/orchestrator</string>
    <string>daemon</string>
    <string>--repo</string>
    <string>/Users/CHANGEME/Project/my-project</string>
    <string>--run-root</string>
    <string>/Users/CHANGEME/Project/my-project/.orchestrator</string>
    <string>--max-cost-hour</string>
    <string>5.00</string>
    <string>--max-cost</string>
    <string>2.00</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RAENIL_URL</key>
    <string>https://tracker.example.com</string>
    <key>RAENIL_TOKEN</key>
    <string>CHANGEME</string>
    <key>OPENCODE_URL</key>
    <string>http://127.0.0.1:4096</string>
    <key>ORCHESTRATOR_MODEL</key>
    <string>opencode-go/glm-5.3-flash</string>
    <key>ORCHESTRATOR_ESCALATE_MODEL</key>
    <string>opencode-go/glm-5.3</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/Project/my-project/.orchestrator/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/Project/my-project/.orchestrator/daemon.err</string>
</dict>
</plist>
